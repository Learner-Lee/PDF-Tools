# Qwen (阿里云百炼 套餐专属 endpoint，OpenAI 兼容协议)
QWEN_API_KEY=sk-xxxxxxxx
QWEN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 模型选型：便宜够用优先，质量不满意时改成 qwen3.7-plus
QWEN_MODEL_TRANSLATE=qwen3.6-flash
QWEN_MODEL_GLOSS=qwen3.6-flash

# 本地模型（llama.cpp server），LLM_PROVIDER=llamacpp 时生效
LLAMACPP_BASE_URL=http://localhost:8080/v1
LLAMACPP_MODEL=local

# 当前使用的 provider: qwen | llamacpp
LLM_PROVIDER=qwen
