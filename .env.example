# ── 首次启动的种子配置 ────────────────────────────────────────
# 这里只是"第一次运行时自动建一份档案"的便利手段。
# 启动后所有配置以本地数据库为准，可在设置界面随时增删改，
# 也可以完全不填这个文件，直接在界面里添加自己的服务。
#
# 支持任何 OpenAI 兼容端点：阿里云百炼、DeepSeek、Moonshot、智谱、
# 硅基流动、OpenAI、OpenRouter，以及本地的 Ollama / llama.cpp。

QWEN_API_KEY=sk-xxxxxxxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_TRANSLATE=qwen3.6-flash
QWEN_MODEL_GLOSS=qwen3.6-flash

# 本地模型示例（无需密钥）：
# QWEN_BASE_URL=http://localhost:8080/v1
# QWEN_MODEL_TRANSLATE=local
